# Personal Claude config (never commit)
CLAUDE.local.md

# Knowledge graph output (regenerated by hook)
graphify-out/

# Data files — local SQLite/DuckDB, scraped PDFs, posteriors
# Anchored at root so package-local data dirs (e.g. pipeline/seed/data/) stay tracked.
/data/
*.db
*.db-wal
*.db-shm
*.duckdb
*.parquet

# Go
bin/
*.exe
# Compiled binaries dropped by `go build` at repo root
/scrape-rss
/scrape-rss-archive
/api
/blackout

# Transient sentiment scaffolds (reproducible from sample_headlines.py)
pipeline/sentiment/fixtures/headlines_labelled.scaffold.csv

# Claude harness transient state
.claude/scheduled_tasks.lock

# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.iml
*.apk
*.aab
android/captures/
android/keystore.properties
*.jks
*.keystore

# Infra secrets (when introduced)
infra/**/*.env
infra/**/secrets*

# IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db
